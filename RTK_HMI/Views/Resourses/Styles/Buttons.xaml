<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <Style  TargetType="Button">
        <Setter Property="Background" Value="#323232"/>
        <Setter Property="Foreground" Value="#323232"/>
        <Setter Property="Margin" Value="5"/>
        
    </Style>
    <Style x:Key="PlcButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#323232"/>
            <!-- Обратите внимание: я изменил Foreground на White, иначе текст #323232 на фоне #323232 будет невидимым -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>

            <!-- Переопределяем шаблон -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Задаем имя (x:Name) границе, чтобы триггер мог к ней обратиться -->
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>

                        <!-- Триггеры внутри шаблона имеют высший приоритет -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- Меняем фон именно у Border внутри шаблона -->
                                <Setter TargetName="ButtonBorder" Property="Background" Value="Gray"/>
                                <Setter Property="Foreground" Value="LightGray"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>

                            <!-- Опционально: эффект при наведении (чтобы кнопка была интерактивной) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#454545"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    
    
    <Style TargetType="fa:IconBlock">
        <Setter Property="Foreground" Value="#ADADAD"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
