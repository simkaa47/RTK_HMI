<UserControl x:Class="RTK_HMI.Views.UserControls.LoggingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RTK_HMI.ViewModels"
             xmlns:local="clr-namespace:RTK_HMI.Views.UserControls"
             xmlns:col1="clr-namespace:System.Collections;assembly=System.Runtime.Extensions"
             xmlns:sys1="clr-namespace:System;assembly=System.Runtime"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LoggingVm}"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="Auto, Auto, *">
        <!--<TextBlock Text="{Binding MainVm.Version}" Style="{StaticResource TextBlockCommonStyle}"/>-->
        
        <!--#region Запустить логирование -->
        <Button VerticalAlignment="Top" Margin="10"
                
                HorizontalAlignment="Left"
                Padding="10"
                Height="60"
                Command="{Binding StartLoggingCommand}">
            <StackPanel Orientation="Horizontal">
                <fa:IconBlock FontFamily="Algerian" Icon="{Binding IsLogging, Converter={StaticResource GetIfTrueConverter}, ConverterParameter={StaticResource LogStateIcon}}"/>
                <TextBlock FontSize="14" Text="{Binding IsLogging, Converter={StaticResource GetIfTrueConverter}, ConverterParameter={StaticResource LogState}}" Margin="10, 0" Style="{StaticResource TextBlockCommonStyle}"/>
            </StackPanel>
            
            <Button.ToolTip>
                <TextBlock Text="Start Logging into a file"/>
            </Button.ToolTip>
        </Button>
        <!--#endregion-->
        
        <!--#region Выбрать файл -->
        <Button VerticalAlignment="Top" Margin="10"
                Visibility="{Binding IsLogging, Converter={StaticResource VisibleIfEqual}, ConverterParameter=False}"
                Grid.Column="1"
                HorizontalAlignment="Left"
                Padding="10"
                Height="60"
                Command="{Binding ChooseFileCommand}">
            <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="FileCircleCheck"/>
                <TextBlock FontSize="14" Text="Choose file..." Margin="10, 0" Style="{StaticResource TextBlockCommonStyle}"/>
            </StackPanel>
        </Button>
        <!--#endregion-->
        
        <!--#region Выбранный путь -->
            <TextBlock Grid.Column="2" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding SelectedFilePath, StringFormat='File path: {0}'}" Style="{StaticResource TextBlockCommonStyle}"/>
        <!--#endregion-->
        

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock  FontSize="24" FontWeight="Bold" Text="{Binding IsLogging, StringFormat='Log status: {0}'}" Style="{StaticResource TextBlockCommonStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Log data interval, ms" Style="{StaticResource TextBlockCommonStyle}"
                    VerticalAlignment="Center"/>
                <TextBox Margin="10"
                         Text="{Binding TimeInterval}"
                         Width="80"
                         VerticalContentAlignment="Center">

                </TextBox>
            </StackPanel>
        </StackPanel>
        
    </Grid>
</UserControl>
